#!/usr/bin/env python3
#
# Helper to convert the old franz lisp source code 
import os
import sys
import pathlib

from subprocess import check_output 
from argparse import ArgumentParser, ArgumentTypeError, RawDescriptionHelpFormatter
from hashlib import md5
from textwrap import dedent


op = os.path


def _parse(args):
    def _ends_with_dot_c(name):
        if not name.endswith(".c"): raise ArgumentTypeError("Not a C source file.")
        return name

    def _valid_directory(path):
        if not op.isdir(path): raise ArgumentTypeError(f"Invalid path {path}.")
        return path

    p = ArgumentParser(description="ANSI-fy old K&R C source.",
                       formatter_class=RawDescriptionHelpFormatter,
                       epilog=dedent("""
                       For one or more K&R style C files, this will convert old-style
                       function parameter definitions to ANSI style parameter definitions
                       
                       The original C file(s) will be overwritten and a .h file is 
                       created in h/prototypes
                       """))
    p.add_argument("files", nargs='+', type=_ends_with_dot_c,
                   help="Name of the C source file(s) to protoize")
    p.add_argument("-I", dest="include_dir", nargs='?', type=_valid_directory,
                   default=op.abspath(op.curdir),
                   help="Directory for the header files. ")
    p.add_argument("--clobber", "-c", action="store_true")

    return p.parse_args(args)

def _header_name(h_dir, f):
    return op.join(h_dir,
                   op.splitext(os.path.basename(f))[0]+'.h')

    
def _main(args):
    okay = True

    includes_rel   = pathlib.Path('.') / '..' / 'franz' / 'h'
    script_dir     = pathlib.Path(__file__).resolve().parent
    includes_dir   = (script_dir / includes_rel).resolve()
    prototypes_dir = (includes_dir / 'prototypes')

    os.makedirs(prototypes_dir, exist_ok=True)

    if not includes_dir.is_dir():
        # 
        # Note- Right now we assume this script is stored in particular
        #       location relative to the includes directory.
        print(f"Did not find header directory in the expected location of\n"
              f"  {includes_rel} \n"
              "relative to \n"
              f"  {script_dir} \n"
              , file=sys.stderr)
        okay = False
    

    for f in args.files:
        h = _header_name(prototypes_dir, f)
        if os.path.exists(h):
            okay = okay and args.clobber 
            print(f"Error: File {h} already exists. ", file=sys.stderr)
        if okay:
            h_contents = check_output(["cproto",
                                       "-I", includes_dir,
                                       "-D", "FILE=int",
                                       "-q",                # no msg if #include fails
                                       "-a",                # convert func defs to ANSI
                                       "-e",                # add extern
                                       f],
                                      encoding="utf-8" )
            guard_id = (f"INC_{op.splitext(op.basename(h))[0]}"
                        + f"_{md5((h.encode('utf-8'))).hexdigest()}_h")

            with open(h, "w") as out:
                out.write(f"/* Autogenerated by {__file__} */\n"
                          f"#ifndef {guard_id}\n"
                          f"#define {guard_id}\n"
                          f"\n"
                          f"{h_contents}\n\n#endif")
                pass

    return 0 if okay else 1


if __name__ == "__main__":
    sys.exit(_main(_parse(sys.argv[1:])))
